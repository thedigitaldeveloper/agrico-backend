# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=1340

# --- Secrets ------------------------------------------------------------
# Generate every one of these fresh per environment: openssl rand -base64 32
# The "toBeModified" values below are placeholders. Shipping them to production
# means anyone who has read this file — it is public on GitHub — can mint admin
# tokens against the live CMS.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database -----------------------------------------------------------
# "mysql" or "postgres". SQLite is not supported on purpose — see the comment
# at the top of config/database.ts.
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=agrico
DATABASE_USERNAME=agrico
DATABASE_PASSWORD=

# Use a user granted rights on this database only. A shared root account turns
# one CMS compromise into every database on the server.
#
# Set to true whenever the database is on another host, or credentials and data
# cross the network in the clear.
DATABASE_SSL=false

# --- Student password recovery ------------------------------------------
# Set to the public frontend reset page; bootstrap applies this to the CMS's
# Users & Permissions advanced settings. No URL is inferred from requests.
PASSWORD_RESET_URL=

# SMTP is enabled only when SMTP_HOST is set. Use your real mail service's
# credentials and verified sender. Blank values do not configure delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Agrico
EMAIL_REPLY_TO=
