{
  "kind": "collectionType",
  "collectionName": "faculties",
  "info": {
    "singularName": "faculty",
    "pluralName": "faculties",
    "displayName": "Faculty",
    "description": "A named member of a university's teaching staff. Not a mentor-profile: these people teach at the university and are not bookable through Agrico."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "designation": {
      "type": "string"
    },
    "qualification": {
      "type": "string"
    },
    "bio": {
      "type": "text",
      "maxLength": 4000
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "social_link": {
      "type": "string"
    },
    "position": {
      "type": "integer"
    },
    "university": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::university.university",
      "inversedBy": "faculties"
    }
  }
}
