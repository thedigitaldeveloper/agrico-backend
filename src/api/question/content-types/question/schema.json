{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Q&A Question",
    "description": "Visitor questions. Draft & publish doubles as moderation: a submission arrives as a draft and only appears on the site once an editor publishes it."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "body": {
      "type": "text",
      "maxLength": 4000
    },
    "author_name": {
      "type": "string",
      "maxLength": 80
    },
    "author_email": {
      "type": "email",
      "private": true,
      "maxLength": 180
    },
    "views": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "question"
    },
    "streams": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::stream.stream"
    },
    "courses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course.course"
    },
    "universities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::university.university"
    }
  }
}
