{
  "kind": "collectionType",
  "collectionName": "recruiters",
  "info": {
    "singularName": "recruiter",
    "pluralName": "recruiters",
    "displayName": "Recruiter",
    "description": "A company that hires from partner universities. Shared across universities, so the same logo is uploaded once."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "universities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::university.university",
      "mappedBy": "recruiters"
    }
  }
}
