{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "A student's own words about their admission. Only publish what someone actually said and agreed to have quoted."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "quote": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "role": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "university": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::university.university"
    },
    "position": {
      "type": "integer"
    }
  }
}
